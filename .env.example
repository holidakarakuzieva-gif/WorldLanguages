# GEMINI_API_KEY: Required for server-side Gemini AI tutoring, story generation, writing review, and TTS.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted application URL injected automatically by AI Studio.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HTTP-only authentication session cookies.
SESSION_SECRET="CHANGE_ME_SESSION_SECRET"

# FOUNDER_BOOTSTRAP_PASSWORD: Initial password used once to bootstrap the founder account (aiworldlanguages@gmail.com).
# Set this securely in Settings > Secrets; never hardcode passwords in source code.
FOUNDER_BOOTSTRAP_PASSWORD=""

# Optional Multi-Provider AI Keys (provider-independent AI service layer)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
